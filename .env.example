# Copy to .env. Everything works with no key (offline parser).
APP_ENV=dev
# GEMINI_API_KEY=
# Default chain. gemini-2.5-flash-lite was dropped: it returns 404 for new users (2026-11-23).
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.8-flash
# SHIELDLEDGER_DB=backend/shieldledger.db
# Pin "today" for reproducible demos (ISO date). Leave unset to use the system date.
# APP_TODAY=2026-11-23
# Per-call Gemini timeout in whole seconds (default 20; minimum 10, Gemini rejects shorter deadlines)
GEMINI_TIMEOUT_S=20
